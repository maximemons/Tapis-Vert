rules_version = '2';

// Règles de sécurité Tapis-Vert.
// Le site étant 100 % client (GitHub Pages), ces règles sont la SEULE barrière réelle :
// tout contrôle fait en JavaScript peut être contourné depuis la console du navigateur.
//
// ⚠ Ce fichier n'est PAS appliqué automatiquement par GitHub. Pour l'activer :
//   console Firebase > Firestore Database > onglet « Règles » > remplacer tout le contenu
//   par celui de ce fichier > « Publier ».   (ou : firebase deploy --only firestore:rules)
// Sans cette étape, la création de liens de visualisation est refusée.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Fonctions utilitaires ---------- */

    // Compte email / mot de passe : créé par l'administrateur, toujours accepté.
    // Compte Google : n'importe qui peut en avoir un, il n'est donc accepté que si son email
    // (vérifié) a un document dans « utilisateurs ».
    function connecte() {
      return request.auth != null && request.auth.token.email != null
        && (request.auth.token.firebase.sign_in_provider == 'password'
            || (request.auth.token.email_verified == true
                && exists(/databases/$(database)/documents/utilisateurs/$(request.auth.token.email))));
    }
    function monEmail() {
      return request.auth.token.email;
    }
    // Moi + les comptes liés (champ « liens » de mon document utilisateur).
    // Robuste : fonctionne même si le document n'existe pas ou si « liens » est absent / mal typé.
    function maFamille() {
      let chemin = /databases/$(database)/documents/utilisateurs/$(monEmail());
      let liens = exists(chemin) ? get(chemin).data.get('liens', []) : [];
      return (liens is list ? liens : []).concat([monEmail()]);
    }
    function cheminPrive(jeton) {
      return /databases/$(database)/documents/partagesPrives/$(jeton);
    }
    function cheminPublic(jeton) {
      return /databases/$(database)/documents/partages/$(jeton);
    }
    function estProprioPartage(jeton) {
      return connecte()
        && exists(cheminPrive(jeton))
        && monEmail() in get(cheminPrive(jeton)).data.proprios;
    }
    function nonExpire(data) {
      return data.expireLe == null || data.expireLe > request.time;
    }
    function jetonValide(jeton) {
      return jeton.matches('^[A-Za-z0-9_-]{32,64}$');
    }

    /* ---------- Utilisateurs ---------- */
    // Lus par le tableau de bord pour construire la liste des propriétaires.
    // Administrés uniquement depuis la console Firebase.
    match /utilisateurs/{email} {
      allow read: if connecte();
      allow write: if false;
    }

    /* ---------- Jeux ---------- */
    // Mes « accès » (champ acces de mon document utilisateur), toujours sous forme de liste.
    function mesAcces() {
      let chemin = /databases/$(database)/documents/utilisateurs/$(monEmail());
      let acces = exists(chemin) ? get(chemin).data.get('acces', []) : [];
      return acces is list ? acces : [];
    }
    // Même logique que construireGroupes() dans scripts/logic.js :
    // ma famille, tout le monde avec « * », les personnes de mes accès et leurs liens.
    function peutVoir(proprio) {
      let cheminProprio = /databases/$(database)/documents/utilisateurs/$(proprio);
      return proprio in maFamille()
        || '*' in mesAcces()
        || proprio in mesAcces()
        || (exists(cheminProprio)
            && get(cheminProprio).data.get('liens', []) is list
            && get(cheminProprio).data.get('liens', []).hasAny(mesAcces()));
    }
    // Forme d'un jeu (identique à Jeux.toDoc() dans scripts/records.js).
    // L'image peut être une image importée (data URL) : plafonnée à 400 000 caractères.
    function jeuValide(d) {
      return d.keys().hasOnly(['proprio', 'nom', 'joueurs', 'duree', 'difficulte', 'styles', 'estExtension',
                               'estPrete', 'description', 'image', 'video', 'emplacement', 'ageMinimal',
                               'dateAchat', 'wishlist', 'note', 'ajouteLe'])
        && d.proprio is string
        && d.nom is string && d.nom.size() > 0 && d.nom.size() <= 200
        && d.get('image', '') is string && d.get('image', '').size() <= 400000
        && d.get('description', '') is string && d.get('description', '').size() <= 100000
        && d.get('joueurs', []) is list && d.get('joueurs', []).size() <= 2
        && d.get('duree', []) is list && d.get('duree', []).size() <= 2
        && d.get('styles', []) is list && d.get('styles', []).size() <= 50;
    }

    match /jeux/{jeuId} {
      // Le tableau de bord lit les jeux propriétaire par propriétaire (proprio == email) :
      // c'est ce qui permet à ces règles de vérifier l'accès.
      allow read: if connecte() && peutVoir(resource.data.proprio);
      // On ne peut créer / modifier / supprimer que les jeux de sa famille,
      // et une modification ne peut pas changer le propriétaire.
      allow create: if connecte()
        && request.resource.data.proprio in maFamille()
        && jeuValide(request.resource.data);
      allow update: if connecte()
        && resource.data.proprio in maFamille()
        && request.resource.data.proprio == resource.data.proprio
        && jeuValide(request.resource.data);
      allow delete: if connecte() && resource.data.proprio in maFamille();
    }

    /* ---------- Liens de visualisation : partie privée ---------- */
    match /partagesPrives/{jeton} {
      allow read: if connecte() && monEmail() in resource.data.proprios;
      allow create: if connecte()
        && jetonValide(jeton)
        && request.resource.data.keys().hasOnly(['proprios', 'creePar', 'libelle', 'titre', 'inclureWishlist', 'expireLe', 'creeLe'])
        && request.resource.data.creePar == monEmail()
        && monEmail() in request.resource.data.proprios
        // Impossible de partager les jeux de quelqu'un hors de sa famille
        && maFamille().hasAll(request.resource.data.proprios)
        && request.resource.data.libelle is string && request.resource.data.libelle.size() <= 80
        && request.resource.data.titre is string && request.resource.data.titre.size() <= 120;
      allow update: if false;
      allow delete: if connecte() && monEmail() in resource.data.proprios;
    }

    /* ---------- Liens de visualisation : partie publique ---------- */
    match /partages/{jeton} {
      // Lecture sans compte si l'on connaît le jeton et que le lien n'a pas expiré.
      allow get: if nonExpire(resource.data) || estProprioPartage(jeton);
      // Interdit d'énumérer les jetons existants.
      allow list: if false;
      allow create: if estProprioPartage(jeton)
        && request.resource.data.keys().hasOnly(['titre', 'inclureWishlist', 'expireLe', 'majLe']);
      allow update: if estProprioPartage(jeton)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['majLe']);
      // Révocation : supprimer ce document coupe immédiatement l'accès aux jeux ci-dessous.
      allow delete: if estProprioPartage(jeton);

      // Copie épurée des jeux (sans email, emprunteur, emplacement ni date d'achat)
      match /jeux/{jeuId} {
        allow read: if estProprioPartage(jeton)
          || (exists(cheminPublic(jeton)) && nonExpire(get(cheminPublic(jeton)).data));
        allow delete: if estProprioPartage(jeton);
        allow create, update: if estProprioPartage(jeton)
          && request.resource.data.get('image', '') is string
          && request.resource.data.get('image', '').size() <= 400000;
      }
    }
  }
}
